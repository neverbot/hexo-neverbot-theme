<footer id="footer" class="footer">
    <div>
        <pre>┌( ಠ_ಠ)┘</pre>
        <pre>4 8 15 16 23 42</pre>
    </div>
    <button id="theme-toggle" type="button">
        <span class="theme-icon-light"><%- fa_inline('moon', { prefix: 'fas' }) %><span class="visually-hidden">Cambiar a modo oscuro</span></span>
        <span class="theme-icon-dark"><%- fa_inline('sun', { prefix: 'fas' }) %><span class="visually-hidden">Cambiar a modo claro</span></span>
    </button>
</footer>

<script>
  (function () {
    var toggle = document.getElementById('theme-toggle');
    var html = document.documentElement;
    var meta = document.querySelector('meta[name="color-scheme"]');
    var system = window.matchMedia('(prefers-color-scheme: dark)');

    function systemTheme() {
      return system.matches ? 'dark' : 'light';
    }

    function show(theme) {
      if (theme) {
        html.setAttribute('data-theme', theme);
      } else {
        html.removeAttribute('data-theme');
      }
      if (meta) meta.content = theme || 'light dark';
    }

    toggle.addEventListener('click', function () {
      var current = html.getAttribute('data-theme') || systemTheme();
      var target = current === 'dark' ? 'light' : 'dark';
      var override = target === systemTheme() ? null : target;
      show(override);
      try {
        if (override) {
          localStorage.setItem('theme', override);
        } else {
          localStorage.removeItem('theme');
        }
      } catch (e) {}
    });

    window.addEventListener('storage', function (event) {
      if (event.key !== 'theme') return;
      var value = event.newValue;
      show(value === 'light' || value === 'dark' ? value : null);
    });
  })();
</script>

<%# video: load plyr only when there are embedded players in the page %>
<script>
  (function () {
    var players = document.querySelectorAll('.js-player');
    if (!players.length) return;

    var base = '<%- url_for('/vendor/plyr-' + theme.plyr.version + '/') %>';
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = base + 'plyr.css';
    document.head.appendChild(link);

    var script = document.createElement('script');
    script.src = base + 'plyr.min.js';
    script.onload = function () {
      Array.from(players).map(function (p) {
        return new Plyr(p, {
          iconUrl: base + 'plyr.svg',
          blankVideo: base + 'blank.mp4',
          disableContextMenu: 0,
          youtube: {
            noCookie: 1,
            modestbranding: 1,
            showinfo: 0,
            controls: 0,
          },
        });
      });
    };
    document.body.appendChild(script);
  })();
</script>

